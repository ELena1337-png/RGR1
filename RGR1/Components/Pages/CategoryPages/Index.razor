@page "/categories"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using RGR1.Data
@implements IAsyncDisposable
@inject IDbContextFactory<RGR1.Data.ApplicationDbContext> DbFactory

<PageTitle>Категории</PageTitle>

<h1>Категории</h1>

<p>
    <a href="categories/create">Добавить новую категорию</a>
</p>

<QuickGrid Class="table" Items="categoriesQuery">
    <PropertyColumn Title = "Название категории" Property  ="category => category.NameCategory" />
    <PropertyColumn Title="Колличество товаров" Property="category => category.Productions!.Count()" />

    <TemplateColumn Context="category">
        <a href="@($"productions?categoryid={category.CategoryId}")">Товары</a> |
        <a href="@($"categories/edit?categoryid={category.CategoryId}")">Редактировать</a> |
        <a href="@($"categories/details?categoryid={category.CategoryId}")">Просмотр</a> |
        <a href="@($"categories/delete?categoryid={category.CategoryId}")">Удалить</a>
    </TemplateColumn>
</QuickGrid>

@code {
    private ApplicationDbContext context = default!;
    private IQueryable<Category> categoriesQuery = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
        categoriesQuery = context.Categories.Include(c => c.Productions);
    }

    public async ValueTask DisposeAsync()
    {
        await context.DisposeAsync();
    }
}

