@page "/productions"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using RGR1.Data
@implements IAsyncDisposable
@inject IDbContextFactory<RGR1.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Товары категории - @NameCategory </PageTitle>

<h1>Товары</h1>

<p>
    <a href="productions/create?categoryid=@CategoryId">Добавить новый товар</a>
</p>
<p>
    <a href="categories">Возврат к списку категорий</a>
</p>

<QuickGrid Class="table" Items="productionsQuery">
    <PropertyColumn Title = "Наименование товаров" Property="production => production.NamePr" />
    <PropertyColumn Title = "Описание" Property="production => production.Description" />
    <PropertyColumn Title = "Цена" Property="production => production.Price" />
    <PropertyColumn Title="Колличество заказов" Property="production => production.Orders!.Count()" />


    <TemplateColumn Context="production">
        <a href="@($"orders?productionid={production.ProductionId}")">Заказы</a> |
       <a href="@($"productions/edit?productionid={production.ProductionId}&categoryid={CategoryId}")">Редактировать</a>|
        <a href="@($"productions/details?productionid={production.ProductionId}&categoryid={CategoryId}")">Просмотр</a> |
        <a href="@($"productions/delete?productionid={production.ProductionId}&categoryid={CategoryId}")">Удалить</a>
    </TemplateColumn>
</QuickGrid>

@code {
    [SupplyParameterFromQuery]
    public int? CategoryId { get; set; }
    public string? NameCategory { get; set; }
    private ApplicationDbContext context = default!;
    private IQueryable<Production> productionsQuery = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();

        if (CategoryId == null)
        {
            NavigationManager.NavigateTo("/categories");
            return;
        }

        var category = context.Categories.FirstOrDefault(d => d.CategoryId == CategoryId);

        if (category == null)
        {
            NavigationManager.NavigateTo("/categories");
            return;
        }

        NameCategory = category.NameCategory;

        productionsQuery = context.Productions
            .Include(p => p.Orders)
            .Where(p => p.CategoryId == CategoryId);
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}