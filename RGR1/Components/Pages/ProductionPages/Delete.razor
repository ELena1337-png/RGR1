@page "/productions/delete"
@using Microsoft.EntityFrameworkCore
@using RGR1.Data
@inject IDbContextFactory<RGR1.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Удаление</PageTitle>

<h1>Удаление</h1>

<p>Вы уверенны, что хотите удалить товар?</p>
<div>
    <hr />
    @if (production is null)
    {
        <p><em>Загрузка...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Наименование товара</dt>
            <dd class="col-sm-10">@production.NamePr</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Описание</dt>
            <dd class="col-sm-10">@production.Description</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Цена</dt>
            <dd class="col-sm-10">@production.Price</dd>
        </dl>
        @* <dl class="row">
            <dt class="col-sm-2">CategoryId</dt>
            <dd class="col-sm-10">@production.CategoryId</dd>
        </dl> *@
        <EditForm method="post" Model="production" OnValidSubmit="DeleteProduction" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(production is null)">Удалить</button> |
            <a href="/productions?categoryid=@CategoryId">Вернуться назад</a>
        </EditForm>
    }
</div>

@code {
    private Production? production;

    [SupplyParameterFromQuery]
    public int? CategoryId { get; set; }

    [SupplyParameterFromQuery]
    private int ProductionId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        production = await context.Productions.FirstOrDefaultAsync(m => m.ProductionId == ProductionId);

        if (production is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteProduction()
    {
        using var context = DbFactory.CreateDbContext();
        context.Productions.Remove(production!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/productions");
    }
}
