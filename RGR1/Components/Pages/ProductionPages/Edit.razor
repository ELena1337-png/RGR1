@page "/productions/edit"
@using Microsoft.EntityFrameworkCore
@using RGR1.Data
@inject IDbContextFactory<RGR1.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

<h1>Edit</h1>

<h2>Production</h2>
<hr />
@if (Production is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="Production" OnValidSubmit="UpdateProduction" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert"/>
                <input type="hidden" name="Production.ProductionId" value="@Production.ProductionId" />
                <div class="mb-3">
                    <label for="namepr" class="form-label">NamePr:</label>
                    <InputText id="namepr" @bind-Value="Production.NamePr" class="form-control" />
                    <ValidationMessage For="() => Production.NamePr" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="description" class="form-label">Description:</label>
                    <InputText id="description" @bind-Value="Production.Description" class="form-control" />
                    <ValidationMessage For="() => Production.Description" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="price" class="form-label">Price:</label>
                    <InputNumber id="price" @bind-Value="Production.Price" class="form-control" />
                    <ValidationMessage For="() => Production.Price" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="categoryid" class="form-label">CategoryId:</label>
                    <InputNumber id="categoryid" @bind-Value="Production.CategoryId" class="form-control" />
                    <ValidationMessage For="() => Production.CategoryId" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/productions">Back to List</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private int ProductionId { get; set; }

    [SupplyParameterFromForm]
    private Production? Production { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        Production ??= await context.Productions.FirstOrDefaultAsync(m => m.ProductionId == ProductionId);

        if (Production is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateProduction()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(Production!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!ProductionExists(Production!.ProductionId))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/productions");
    }

    private bool ProductionExists(int productionid)
    {
        using var context = DbFactory.CreateDbContext();
        return context.Productions.Any(e => e.ProductionId == productionid);
    }
}
