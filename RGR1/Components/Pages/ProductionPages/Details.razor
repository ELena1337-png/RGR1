@page "/productions/details"
@using Microsoft.EntityFrameworkCore
@using RGR1.Data
@inject IDbContextFactory<RGR1.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<h1>Details</h1>

<div>
    <h2>Production</h2>
    <hr />
    @if (production is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">NamePr</dt>
            <dd class="col-sm-10">@production.NamePr</dd>
            <dt class="col-sm-2">Description</dt>
            <dd class="col-sm-10">@production.Description</dd>
            <dt class="col-sm-2">Price</dt>
            <dd class="col-sm-10">@production.Price</dd>
            <dt class="col-sm-2">CategoryId</dt>
            <dd class="col-sm-10">@production.CategoryId</dd>
        </dl>
        <div>
            <a href="@($"/productions/edit?productionid={production.ProductionId}")">Edit</a> |
            <a href="@($"/productions")">Back to List</a>
        </div>
    }
</div>

@code {
    private Production? production;

    [SupplyParameterFromQuery]
    private int ProductionId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        production = await context.Productions.FirstOrDefaultAsync(m => m.ProductionId == ProductionId);

        if (production is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
}
