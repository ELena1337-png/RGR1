@page "/productions/details"
@using Microsoft.EntityFrameworkCore
@using RGR1.Data
@inject IDbContextFactory<RGR1.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Просмотр</PageTitle>

<h1>Просмотр</h1>

<div>
    <hr />
    @if (production is null)
    {
        <p><em>Загрузка...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Наименование товара</dt>
            <dd class="col-sm-10">@production.NamePr</dd>
            <dt class="col-sm-2">Описание</dt>
            <dd class="col-sm-10">@production.Description</dd>
            <dt class="col-sm-2">Цена</dt>
            <dd class="col-sm-10">@production.Price</dd>
            @* <dt class="col-sm-2">CategoryId</dt>
            <dd class="col-sm-10">@production.CategoryId</dd> *@
        </dl>
        <div>
            <a href="@($"productions/edit?productionid={production.ProductionId}&categoryid={CategoryId}")">Редактировать</a> |
            <a href="/productions?categoryid=@CategoryId">Вернуться назад</a>
        </div>
    }
</div>

@code {
    private Production? production;

    [SupplyParameterFromQuery]
    public int? CategoryId { get; set; }
    
    [SupplyParameterFromQuery]
    private int ProductionId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        production = await context.Productions.FirstOrDefaultAsync(m => m.ProductionId == ProductionId);

        if (production is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
}
